<resources>
    <string name="app_name">HyperOS 通知数量</string>
    <string name="module_description">将 HyperOS 4 顶部通知图标替换为通知总条数：1–9，超过 9 显示 ···。仅作用于系统界面。</string>
    <string name="settings_title">通知数量</string>
    <string name="settings_version">版本 %1$s · 系统界面</string>
    <string name="settings_back">返回</string>
    <string name="settings_intro">下方过滤开关开启 = 从数量中排除这类通知。过滤默认全部关闭，只改变计数，不清除通知。显示样式中的选项单独控制徽标外观。</string>
    <string name="settings_section_display">显示样式</string>
    <string name="settings_icon_color_title">跟随通知 App 图标颜色</string>
    <string name="settings_icon_color_description">默认关闭。开启后，圆点使用最新参与计数通知的 App 图标候选色，并适应深浅背景。取不到彩色时沿用系统黑白色。数字仍表示通知总数。</string>
    <string name="settings_temporary_color_title">临时变色</string>
    <string name="settings_temporary_color_description">默认关闭。开启后，变色仅持续所选时长，到期恢复系统当前的黑白色。新通知重新计时，同一条通知的进度更新不延长时长。</string>
    <string name="settings_color_duration_title">变色持续时间</string>
    <string name="settings_color_duration_description">默认 5 秒，修改后从当前通知重新计时。</string>
    <string name="settings_color_seconds">%1$d 秒</string>
    <string name="settings_digit_color_title">数字颜色</string>
    <string name="settings_digit_color_description">仅在跟随图标颜色时生效。自动：按圆点颜色选黑或白，取对比度更高者；透明：数字镂空，透出状态栏背景。系统黑白时数字始终镂空。</string>
    <string name="settings_digit_color_auto">自动</string>
    <string name="settings_digit_color_white">白色</string>
    <string name="settings_digit_color_black">黑色</string>
    <string name="settings_digit_color_transparent">透明</string>
    <string name="settings_badge_contrast_title">圆点对比度</string>
    <string name="settings_badge_contrast_description">仅在跟随图标颜色时生效。图标色与状态栏背景对比不足时，会调亮或调暗到所选程度：柔和 3:1，更接近原色；标准 4.5:1；高 7:1，更醒目。</string>
    <string name="settings_badge_contrast_soft">柔和</string>
    <string name="settings_badge_contrast_standard">标准</string>
    <string name="settings_badge_contrast_high">高</string>
    <string name="settings_digit_weight_title">数字粗细</string>
    <string name="settings_digit_weight_description">圆点内数字的笔画粗细，黑白与彩色模式都生效。</string>
    <string name="settings_digit_weight_normal">普通</string>
    <string name="settings_digit_weight_medium">中等</string>
    <string name="settings_digit_weight_bold">最粗</string>
    <string name="settings_overlap">一条通知可能同时属于多类；命中任一已开启的开关就会被排除。建议每次只开一项，观察状态栏数字的变化，再决定组合。</string>
    <string name="settings_selected">已开启 %1$d 项过滤</string>
    <string name="settings_ready">设置已连接。变更会实时发送到同一空间的系统界面；首次更新模块仍需按平时的方式使新版生效。</string>
    <string name="settings_waiting">等待模块框架连接。请先在模块管理器启用本模块，并从模块设置入口打开此页。</string>
    <string name="settings_connecting">正在读取设置…</string>
    <string name="settings_saving">正在保存…</string>
    <string name="settings_unavailable">暂时无法连接模块框架，开关不可修改。请检查模块是否启用，或重新打开设置页。</string>
    <string name="settings_save_failed">保存失败，已恢复上次确认的开关状态。请重试连接后再修改。</string>
    <string name="settings_retry">重试连接</string>
    <string name="settings_reset">关闭全部过滤</string>
    <string name="settings_section_focus">超级岛与实时通知</string>
    <string name="settings_section_ongoing">固定与持续运行</string>
    <string name="settings_section_content">通知内容与展示状态</string>
    <string name="filter_focus_title">焦点通知</string>
    <string name="filter_focus_description">系统认定为焦点通知的条目，范围可能比超级岛更广。</string>
    <string name="filter_island_title">包含超级岛内容</string>
    <string name="filter_island_description">通知带有超级岛内容数据；不代表此刻正在岛上显示。充电等独立系统卡片不一定属于通知条目。</string>
    <string name="filter_updatable_title">可更新的焦点通知</string>
    <string name="filter_updatable_description">系统认定为可以持续更新的焦点通知，用于测试 HyperOS 实时通知。</string>
    <string name="filter_promoted_title">已提升的 Android 实时通知</string>
    <string name="filter_promoted_description">系统已将通知标记为 promoted ongoing；与小米焦点通知是不同判据。</string>
    <string name="filter_request_title">请求实时通知展示</string>
    <string name="filter_request_description">应用请求 promoted ongoing 展示，即使系统尚未批准也会匹配。</string>
    <string name="filter_persistent_title">系统固定通知</string>
    <string name="filter_persistent_description">系统应用的 miui.isPersistent 固定标记；不等同于所有常驻或不可清除通知。</string>
    <string name="filter_ongoing_title">持续运行标记</string>
    <string name="filter_ongoing_description">带有 ongoing 标记的通知，例如部分下载、导航或后台运行状态。</string>
    <string name="filter_no_clear_title">禁止清除标记</string>
    <string name="filter_no_clear_description">带有 no clear 标记的通知，单独测试它与常驻通知的关系。</string>
    <string name="filter_foreground_title">前台服务通知</string>
    <string name="filter_foreground_description">带有前台服务标记的通知；可能同时具有持续运行标记。</string>
    <string name="filter_not_clearable_title">当前不可清除</string>
    <string name="filter_not_clearable_description">按系统当前条目的可清除状态判断，也考虑分组和焦点通知的特殊规则。</string>
    <string name="filter_pinned_title">悬浮通知固定中</string>
    <string name="filter_pinned_description">顶部悬浮通知当前处于固定状态；解除固定后自动恢复参与计数。</string>
    <string name="filter_media_title">媒体播放通知</string>
    <string name="filter_media_description">系统认定的媒体通知，包含 Android 媒体样式及小米媒体扩展。</string>
    <string name="filter_call_title">通话类通知</string>
    <string name="filter_call_description">通知声明为通话类别或通话样式；由应用提供，不代表一定正在通话。</string>
    <string name="filter_silent_title">静默分区通知</string>
    <string name="filter_silent_description">按系统列表的静默分区判断；暂未分区的条目也可能匹配，不等同于应用关闭提示音。</string>
    <string name="filter_folded_title">折叠通知</string>
    <string name="filter_folded_description">系统实际标记为折叠的条目；切换普通页或折叠页不会改变此判据。</string>
</resources>
